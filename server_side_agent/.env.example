# =====================================================================
# Privamon Server-Side Reasoning Agent Configuration
# Copy this file to .env (git-ignored) and fill in your values
# =====================================================================

# Active VLM Provider: "ollama" (local testing) or "openrouter" (cloud)
VLM_PROVIDER=ollama

# OpenRouter API Key (Required if VLM_PROVIDER=openrouter)
# Generate from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model Configuration
# Local Ollama model tag
VLM_MODEL_OLLAMA=qwen3-vl:2b

# OpenRouter multimodal vision model identifier
# Recommended vision models on OpenRouter:
# - qwen/qwen2.5-vl-72b-instruct (Powerful, high accuracy)
# - qwen/qwen3-vl-8b-instruct (Very fast, extremely low latency and cost)
# - qwen/qwen3-vl-32b-instruct
VLM_MODEL_OPENROUTER=qwen/qwen2.5-vl-72b-instruct
